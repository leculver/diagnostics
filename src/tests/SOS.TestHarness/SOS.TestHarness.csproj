<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Test-support library (drives an in-process dbgeng + dotnet-dump to assert SOS output). Not a
         shipping product and not a test project itself. net10.0 is required by
         Microsoft.Diagnostics.Runtime.Utilities (ships net10.0 only). dbgeng is Windows-only but loaded
         at runtime, so the library itself is RID-neutral. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SOS.TestHarness.EngineHost" />
  </ItemGroup>

  <ItemGroup>
    <!-- The lldb command-framing helper imported by LldbCliHost at runtime (resolved next to the
         assembly via RepoLayout/AppContext.BaseDirectory). Copied to the output directory. -->
    <None Include="lldbhelper.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-process dbgeng COM wrappers (IDebugClient/Control/...). Already a repo dependency. -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime.Utilities" Version="$(MicrosoftDiagnosticsRuntimeUtilitiesVersion)" />
    <!-- xUnit v3 core (library variant, no executable enforcement) so the harness can expose
         TheoryData-based matrices for the test project to consume. Version from the Arcade default. -->
    <PackageReference Include="xunit.v3.extensibility.core" Version="$(XUnitV3Version)" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <!-- Full DbgEng payload (dbgeng.dll + winext extension gallery) the cdb hosts load at runtime via
         ToolPaths.DbgEngDirectory. Supplies the !address-class gallery commands the stripped cdb-sos
         engine lacks. PackageDownload (not a compile reference): we only need it restored on disk. -->
    <PackageDownload Include="Microsoft.Debugging.DbgEng.Core" Version="[$(MicrosoftDebuggingDbgEngCoreVersion)]" />
  </ItemGroup>

</Project>
